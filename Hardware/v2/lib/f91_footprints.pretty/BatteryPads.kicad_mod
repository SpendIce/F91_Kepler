(footprint "BatteryPads"
	(version 20260206)
	(generator "f91-custom")
	(layer "F.Cu")
	(descr "Solder pads for LiPo battery cell wires. Pad 1 = positive (+), pad 2 = negative (-). Large SMD pads 2.0x3.0mm for hand-soldering battery lead wires. 4mm centre-to-centre spacing. Orientation: pad 1 on left, pad 2 on right.")
	(tags "battery LiPo pads solder wire")
	(property "Reference" "REF**"
		(at 0 -3 0)
		(layer "F.SilkS")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(property "Value" "BatteryPads"
		(at 0 3 0)
		(layer "F.Fab")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(attr smd)
	(duplicate_pad_numbers_are_jumpers no)
	(fp_rect
		(start -4 -2)
		(end 4 2)
		(stroke
			(width 0.05)
			(type solid)
		)
		(fill no)
		(layer "F.CrtYd")
	)
	(fp_rect
		(start -3.5 -1.75)
		(end 3.5 1.75)
		(stroke
			(width 0.1)
			(type solid)
		)
		(fill no)
		(layer "F.Fab")
	)
	(fp_text user "+"
		(at -2 -1.3 0)
		(layer "F.SilkS")
		(effects
			(font
				(size 1.2 1.2)
				(thickness 0.18)
				(bold yes)
			)
		)
	)
	(fp_text user "-"
		(at 2 -1.3 0)
		(layer "F.SilkS")
		(effects
			(font
				(size 1.2 1.2)
				(thickness 0.18)
				(bold yes)
			)
		)
	)
	(fp_text user "${REFERENCE}"
		(at 0 0 0)
		(layer "F.Fab")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(pad "1" smd rect
		(at -2 0)
		(size 2 3)
		(layers "F.Cu" "F.Mask" "F.Paste")
	)
	(pad "2" smd rect
		(at 2 0)
		(size 2 3)
		(layers "F.Cu" "F.Mask" "F.Paste")
	)
	(embedded_fonts no)
