		(start -1 -1)
		(end 1 1)
		(stroke
			(width 0.05)
			(type solid)
		)
		(fill no)
		(layer "F.CrtYd")
	)
	(fp_text user "IFA: copy v1 antenna geometry + keepout"
		(at 0 0.2 0)
